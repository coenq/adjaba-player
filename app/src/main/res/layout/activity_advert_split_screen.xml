<?xml version="1.0" encoding="utf-8"?>
<!--
    Split Screen layout: landscape TV only.
    Left 70%  → rotating ads (IMAGE / VIDEO / WEB_CONTENT / LIVE_STREAM / weather)
    Right 30% → social feed rotation (or news fallback when no social feeds in playlist)
    ExoPlayer uses resize_mode="zoom" (= centerCrop equivalent) to avoid geometric
    distortion in the non-16:9 left zone.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splitMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tvBg">

    <!-- Vertical guideline: left = 70%, right = 30% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/zoneDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.70" />

    <!-- Thin separator -->
    <View
        android:id="@+id/dividerLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#2A2A2A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/zoneDivider"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════════════════════════════════════
         LEFT ZONE (0 → 70%): ad rotation
         ══════════════════════════════════════════════════ -->

    <!-- Waiting splash -->
    <ImageView
        android:id="@+id/waitingLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:padding="80dp"
        android:scaleType="fitCenter"
        android:src="@drawable/adjaba_logo_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zoneDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ad image — centerCrop clips ~12% sides for 16:9 content in 5:4 zone -->
    <ImageView
        android:id="@+id/adImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zoneDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ad video — resize_mode="zoom" avoids squash/stretch in non-16:9 zone -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/adPlayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zoneDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="zoom"
        app:use_controller="false" />

    <!-- Web content slide -->
    <com.adjaba.content.SecureSignageWebView
        android:id="@+id/webContentView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zoneDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Weather slide — horizontal split: left = clock, right = conditions -->
    <LinearLayout
        android:id="@+id/weatherLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_weather_slide"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zoneDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left half: location + time + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/loc_pin_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/baseline_location_pin_24"
                    android:tint="@color/tvAccent" />
                <TextView
                    android:id="@+id/weatherLoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:maxLines="1"
                    android:text="London"
                    android:textColor="@color/tvTextSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/timeNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="15:05"
                android:textColor="@color/tvTextPrimary"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="Thu, 15 May"
                android:textAllCaps="true"
                android:textColor="@color/tvTextSecondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/tvBorder" />

        <!-- Right half: weather icon + temp + condition + metrics -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/currentWeatherImg"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="24°C"
                android:textColor="@color/tvTextPrimary"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:text="PARTLY CLOUDY"
                android:textAllCaps="true"
                android:textColor="@color/tvTextSecondary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tvBorder"
                android:layout_marginBottom="12dp"/>

            <!-- Metrics row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:alpha="0.80" android:src="@drawable/ic_wind" android:tint="@color/tvTextSecondary"/>
                    <TextView android:id="@+id/windW" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" android:text="--"
                        android:textColor="@color/tvTextPrimary" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light" android:text="km/h"
                        android:textColor="@color/tvTextSecondary" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:alpha="0.80" android:src="@drawable/ic_humidity" android:tint="@color/tvTextSecondary"/>
                    <TextView android:id="@+id/hamudity" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" android:text="--"
                        android:textColor="@color/tvTextPrimary" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light" android:text="humidity"
                        android:textColor="@color/tvTextSecondary" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:alpha="0.80" android:src="@drawable/ic_thermostat" android:tint="@color/tvTextSecondary"/>
                    <TextView android:id="@+id/rain" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" android:text="--"
                        android:textColor="@color/tvTextPrimary" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light" android:text="feels like"
                        android:textColor="@color/tvTextSecondary" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:alpha="0.80" android:src="@drawable/ic_pressure" android:tint="@color/tvTextSecondary"/>
                    <TextView android:id="@+id/pressure" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" android:text="--"
                        android:textColor="@color/tvTextPrimary" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light" android:text="hPa"
                        android:textColor="@color/tvTextSecondary" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Brand logo — bottom-left of left zone -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/final_logo"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Marquee display text — top of left zone -->
    <TextView
        android:id="@+id/displayText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/tvTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/zoneDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════════════════════════════════════
         RIGHT ZONE (70% → 100%): social feed / news
         ══════════════════════════════════════════════════ -->

    <!-- Social feed panel (shown when playlist has SOCIAL_FEED items) -->
    <FrameLayout
        android:id="@+id/socialFeedLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#111111"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dividerLine"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header row: platform label + hashtag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/socialPlatformLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/socialHashtagLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/tvAccent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Accent underline -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/tvAccent" />

            <!-- Live Twitter/X hashtag timeline -->
            <com.adjaba.content.SecureSignageWebView
                android:id="@+id/socialFeedWebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <!-- News fallback panel (shown when no SOCIAL_FEED items in playlist) -->
    <LinearLayout
        android:id="@+id/newsRightLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dividerLine"
        app:layout_constraintTop_toTopOf="parent">

        <!-- "NEWS" badge -->
        <TextView
            android:id="@+id/newsRightBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_news_badge"
            android:letterSpacing="0.15"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="NEWS"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Headline -->
        <TextView
            android:id="@+id/newsRightHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="4"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Accent bar -->
        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginBottom="14dp"
            android:background="@color/tvAccent" />

        <!-- Description -->
        <TextView
            android:id="@+id/newsRightDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="6"
            android:textColor="#B3B3B3"
            android:textSize="13sp" />

        <!-- Source -->
        <TextView
            android:id="@+id/newsRightSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:textAllCaps="true"
            android:textColor="@color/tvAccent"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
